# Deployment rules for the existing static FTP/LiteSpeed serving path.
# The Node worker applies the same policy in server/plugins/site-policy.ts.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; img-src 'self' data: https://assets.calendly.com; font-src 'self' data:; connect-src 'self' https://formspree.io https://calendly.com https://assets.calendly.com; frame-src https://calendly.com; form-action 'self' https://formspree.io"
  Header always set Strict-Transport-Security "max-age=300" "expr=%{HTTPS} == 'on'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Resolve legacy entry points directly to the preferred HTTPS, non-www URLs.
  RewriteRule ^$ https://serporank.com/seo-for-home-cleaning-businesses/ [R=301,L,NE]
  RewriteRule ^seo-for-home-cleaning-businesses$ https://serporank.com/seo-for-home-cleaning-businesses/ [R=301,L,NE]
  RewriteRule ^services/?$ https://serporank.com/seo-for-home-cleaning-businesses/#our-seo-services [R=301,L,NE]
  RewriteRule ^(?:seo-audit|services/seo-audits)/?$ https://serporank.com/seo-for-home-cleaning-businesses/#book-free-audit [R=301,L,NE]
  RewriteRule ^services/website-development/?$ https://serporank.com/seo-for-home-cleaning-businesses/ [R=301,L,NE]
  RewriteRule ^pricing/?$ https://serporank.com/packages [R=301,L,NE]

  # Collapse duplicate HTTP and www hosts while preserving path and query data.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^serporank\.com$ [NC]
  RewriteRule ^ https://serporank.com%{REQUEST_URI} [R=301,L,NE]

  # The homepage keeps its trailing slash; other public pages use slashless URLs.
  RewriteRule ^(about|blog|blog/(?:house-cleaning-seo-guide|seo-vs-meta-ads)|contact|packages|services/(?:local-seo|on-page-seo|off-page-seo|technical-seo))/$ https://serporank.com/$1 [R=301,L,NE]

  # Serve clean URLs without requiring a second directory-slash redirect.
  RewriteRule ^(about|blog|blog/(?:house-cleaning-seo-guide|seo-vs-meta-ads)|contact|packages|services/(?:local-seo|on-page-seo|off-page-seo|technical-seo))$ $1/index.html [L]
</IfModule>
